<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:IT_viddil_monitoring">
    <FontFamily x:Key="TextFont">pack://application:,,,/IT_viddil_monitoring_v3;component/assets/fonts/#Inter</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/IT_viddil_monitoring_v3;component/assets/fonts/#Inter Display</FontFamily>
    <SolidColorBrush x:Key="WindowBrush" Color="#F2F3F7"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F4FFFFFF"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#1834476A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#5F6470"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0066D9"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#8455C9"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#AE5B00"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#EBEEF4"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#DDE4EF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#E8ECF3"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#A5AAB7"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#CFE1FF"/>
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="RowSelectionBrush" Color="#EBF3FF"/>
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SwitchOnBrush" Color="#238E4C"/>
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BadgeBrush" Color="#DDEBFF"/>
    <SolidColorBrush x:Key="GlassTintBrush" Color="#ADFFFFFF"/>
    <SolidColorBrush x:Key="GlassOpaqueBrush" Color="#F5F6FA"/>
    <Color x:Key="BackgroundTopColor">#F6F7FB</Color>
    <Color x:Key="BackgroundBottomColor">#E8EAF5</Color>
    <Color x:Key="RibbonBlueColor">#979BD5F9</Color>
    <Color x:Key="RibbonPurpleColor">#ADC6BFF0</Color>
    <Color x:Key="RibbonPinkColor">#81F6D2C4</Color>
    <Color x:Key="RibbonFadeColor">#00DBE5F6</Color>
    <Color x:Key="GlassEdgeTopColor">#F7FFFFFF</Color>
    <Color x:Key="GlassEdgeBottomColor">#605D789F</Color>
    <Color x:Key="GlassSheenColor">#90FFFFFF</Color>
    <Color x:Key="GlassShadowColor">#425778</Color>
    <Color x:Key="CardShadowColor">#3C5070</Color>
    <Color x:Key="GlassClearColor">#00FFFFFF</Color>
    <LinearGradientBrush x:Key="BackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource BackgroundTopColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource BackgroundBottomColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0.65,1">
        <GradientStop Color="{DynamicResource GlassEdgeTopColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource GlassEdgeTopColor}" Offset="0.18"/>
        <GradientStop Color="{DynamicResource GlassEdgeBottomColor}" Offset="0.62"/>
        <GradientStop Color="{DynamicResource GlassEdgeTopColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="{DynamicResource GlassSheenColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource GlassClearColor}" Offset="0.55"/>
        <GradientStop Color="{DynamicResource GlassSheenColor}" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="18" Margin="-3"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="DisplayNumber" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <Style TargetType="local:GlassPanel">
        <Setter Property="Padding" Value="24,18"/>
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="local:GlassPanel">
                <Grid>
                    <Border Background="{DynamicResource GlassOpaqueBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0.8">
                        <Border.CacheMode><BitmapCache/></Border.CacheMode>
                        <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.13" Color="{DynamicResource GlassShadowColor}"/></Border.Effect>
                    </Border>
                    <Grid x:Name="PART_Clip">
                        <Border x:Name="PART_Backdrop" Opacity="{TemplateBinding BackdropOpacity}" IsHitTestVisible="False">
                        </Border>
                        <Border Background="{DynamicResource GlassTintBrush}" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border Background="{DynamicResource GlassSheenBrush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                        <Border BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1.25" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="0.5" CornerRadius="{TemplateBinding CornerRadius}" Margin="2" Opacity="0.35"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="26"/>
        <Setter Property="Padding" Value="22"/>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="MaxWidth" Value="520"/>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="485"/></DataTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Shell" CornerRadius="22" Background="{DynamicResource GlassTintBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.7"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="RadioButton">
                <Border x:Name="SegmentShell" CornerRadius="18" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SegmentShell" Property="Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="SegmentShell" Property="Background" Value="{DynamicResource SegmentSelectedBrush}"/><Setter TargetName="SegmentShell" Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="LiveSwitch" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Реальний час" FontFamily="{StaticResource TextFont}" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border x:Name="SwitchTrack" Background="{DynamicResource TrackBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="17" Width="54" Height="32">
                        <Border x:Name="SwitchThumb" Background="{DynamicResource SwitchThumbBrush}" CornerRadius="13" Width="26" Height="26" HorizontalAlignment="Left" Margin="2,0"/>
                    </Border>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource SwitchOnBrush}"/><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="Opacity" Value="0.85"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemShell" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}" Margin="3,1">
                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource TextFont}" FontSize="12"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="MinWidth" Value="115"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ComboShell" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="19">
                                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
                            </Border>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboShell" Property="Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Margin="14,0,31,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"/>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                        <Border Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="4" Margin="0,5,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                            <ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="RowShell" CornerRadius="14" BorderBrush="Transparent" BorderThickness="1" Background="Transparent"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowShell" Property="Background" Value="{DynamicResource ControlBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowShell" Property="Background" Value="{DynamicResource RowSelectionBrush}"/><Setter TargetName="RowShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource ScrollThumbBrush}" CornerRadius="4" Margin="1"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                </Track>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
</ResourceDictionary>
