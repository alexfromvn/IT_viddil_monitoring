<Window x:Class="IT_viddil_monitoring.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IT_viddil_monitoring"
        Title="IT_viddil_monitoring · 3.0.1" Icon="{DynamicResource AppIcon}"
        Width="1400" Height="940" MinWidth="820" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource TextFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Typography.NumeralAlignment="Tabular" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles.xaml"/><ResourceDictionary Source="Icon.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid x:Name="AmbientBackground" Background="{DynamicResource BackdropBrush}" IsHitTestVisible="False" ClipToBounds="True">
            <Viewbox Stretch="Fill">
                <Canvas Width="1400" Height="940">
                    <Path Data="M 620,-120 C 770,130 1020,35 1520,265 L 1520,640 C 1230,450 970,520 785,260 C 710,155 685,60 620,-120 Z">
                        <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0.65,1"><GradientStop Color="{DynamicResource RibbonFadeColor}" Offset="0"/><GradientStop Color="{DynamicResource RibbonBlueColor}" Offset="0.42"/><GradientStop Color="{DynamicResource RibbonFadeColor}" Offset="1"/></LinearGradientBrush></Path.Fill>
                    </Path>
                    <Path Data="M 100,-180 C 380,-70 350,300 810,460 C 1030,535 1080,630 1370,1080 L 900,1080 C 780,860 540,560 310,440 C 90,330 135,10 100,-180 Z">
                        <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6"><GradientStop Color="{DynamicResource RibbonFadeColor}" Offset="0"/><GradientStop Color="{DynamicResource RibbonPurpleColor}" Offset="0.44"/><GradientStop Color="{DynamicResource RibbonFadeColor}" Offset="1"/></LinearGradientBrush></Path.Fill>
                    </Path>
                    <Ellipse Width="960" Height="650" Canvas.Left="-220" Canvas.Top="500">
                        <Ellipse.Fill><RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5"><GradientStop Color="{DynamicResource RibbonPinkColor}" Offset="0"/><GradientStop Color="{DynamicResource RibbonFadeColor}" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                    </Ellipse>
                </Canvas>
            </Viewbox>
        </Grid>
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,18">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="AppIconImage" Source="{StaticResource AppIcon}" Width="42" Height="42" Margin="0,0,13,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="IT_viddil_monitoring" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold"/>
                                <Border Background="{DynamicResource BadgeBrush}" CornerRadius="10" Padding="9,4" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="3.0.1" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></Border>
                            </StackPanel>
                            <TextBlock Text="Що сповільнює ваш комп’ютер" Style="{StaticResource Label}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="ThemeButton" Grid.Column="1" Click="Theme_Click" Content="Темна тема" VerticalAlignment="Center" AutomationProperties.Name="Змінити тему" ToolTip="Перемкнути світлу або темну тему"/>
                </Grid>
                <local:GlassPanel x:Name="LeaderGlass" BackdropSource="{Binding ElementName=AmbientBackground}" BackdropOpacity="{DynamicResource GlassBackdropOpacity}" Margin="0,0,0,16" Padding="24,20" CornerRadius="30">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="195"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="{DynamicResource BadgeBrush}" CornerRadius="9" Width="24" Height="24" Margin="0,0,9,0">
                                    <Path Data="M 5 5 L 15 5 L 15 9 C 15 14 5 14 5 9 Z M 5 6 L 2 6 L 2 9 Q 2 12 6 12 M 15 6 L 18 6 L 18 9 Q 18 12 14 12 M 10 13 L 10 17 M 6 18 L 14 18" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Border>
                                <TextBlock x:Name="OverallCaption" Text="Топ 1 · З моменту відкриття" Style="{StaticResource Label}" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="OverallLeader" Text="Збираємо дані…" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="OverallStats" Text="CPU + Пам’ять + I/O" Style="{StaticResource Label}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="24,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Час спостереження" Style="{StaticResource Label}" FontSize="11"/>
                                <TextBlock x:Name="ElapsedText" Text="00:00:00" Style="{StaticResource DisplayNumber}" FontSize="30" Margin="0,5,0,3"/>
                                <StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="{DynamicResource SwitchOnBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Оновлення щосекунди" Style="{StaticResource Label}" FontSize="10"/></StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </local:GlassPanel>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="22,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="M 5 5 L 17 5 L 17 17 L 5 17 Z M 8 8 L 14 8 L 14 14 L 8 14 Z M 8 1 L 8 5 M 14 1 L 14 5 M 8 17 L 8 21 M 14 17 L 14 21 M 1 8 L 5 8 M 1 14 L 5 14 M 17 8 L 21 8 M 17 14 L 21 14" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Margin="0,0,8,0"/>
                                <TextBlock Text="Лідер процесора" Style="{StaticResource Label}"/>
                            </StackPanel>
                            <TextBlock x:Name="CpuValue" Text="—" Style="{StaticResource DisplayNumber}" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="CpuLeader" Text="Збираємо дані…" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="M 2 4 L 20 4 L 20 14 L 2 14 Z M 5 7 L 8 7 L 8 11 L 5 11 Z M 11 7 L 14 7 L 14 11 L 11 11 Z M 5 14 L 5 18 M 9 14 L 9 18 M 13 14 L 13 18 M 17 14 L 17 18" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource PurpleBrush}" StrokeThickness="1.5" Margin="0,0,8,0"/>
                                <TextBlock Text="Лідер пам’яті" Style="{StaticResource Label}"/>
                            </StackPanel>
                            <TextBlock x:Name="MemoryValue" Text="—" Style="{StaticResource DisplayNumber}" Foreground="{DynamicResource PurpleBrush}"/>
                            <TextBlock x:Name="MemoryLeader" Text="Збираємо дані…" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="22,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="M 4 2 L 18 2 L 21 15 L 1 15 Z M 1 15 L 1 20 L 21 20 L 21 15 M 16 17 L 18 17 M 5 17 L 6 17" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource BlueBrush}" StrokeThickness="1.5" Margin="0,0,8,0"/>
                                <TextBlock Text="Лідер диска / I/O" Style="{StaticResource Label}"/>
                            </StackPanel>
                            <TextBlock x:Name="DiskValue" Text="—" Style="{StaticResource DisplayNumber}" Foreground="{DynamicResource BlueBrush}"/>
                            <TextBlock x:Name="DiskLeader" Text="Збираємо дані…" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <local:GlassPanel x:Name="ModeGlass" BackdropSource="{Binding ElementName=AmbientBackground}" BackdropOpacity="{DynamicResource GlassBackdropOpacity}" Margin="0,0,0,20" Padding="22,14" CornerRadius="32">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ModeHint" Text="З моменту відкриття" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="ModeDescription" Text="Середні показники за весь час спостереження" Style="{StaticResource Label}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                        <ToggleButton x:Name="LiveToggle" Grid.Column="2" Style="{StaticResource LiveSwitch}" VerticalAlignment="Center" Checked="Mode_Changed" Unchecked="Mode_Changed" AutomationProperties.Name="Реальний час" ToolTip="Змінити режим вимірювання для всього екрана"/>
                    </Grid>
                </local:GlassPanel>
                <Grid x:Name="MainPanels" Height="390">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.22*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                    <Border x:Name="RankingPanel" Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Рейтинг навантаження" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ChartHint" Style="{StaticResource Label}" Text="Процесор · найбільше зверху" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                                <Border Grid.Column="1" CornerRadius="20" Background="{DynamicResource ControlBrush}" Padding="3" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ChartCpuSegment" GroupName="ChartResource" Style="{StaticResource Segment}" Content="CPU" Tag="0" IsChecked="True" Checked="ChartSegment_Checked" AutomationProperties.Name="Графік процесора"/>
                                        <RadioButton x:Name="ChartMemorySegment" GroupName="ChartResource" Style="{StaticResource Segment}" Content="ОЗП" Tag="2" Checked="ChartSegment_Checked" AutomationProperties.Name="Графік пам’яті"/>
                                        <RadioButton x:Name="ChartDiskSegment" GroupName="ChartResource" Style="{StaticResource Segment}" Content="I/O" Tag="1" Checked="ChartSegment_Checked" AutomationProperties.Name="Графік читання й запису"/>
                                    </StackPanel>
                                </Border>
                                <ComboBox x:Name="ChartMetric" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="ChartMetric_SelectionChanged"><ComboBoxItem Content="Процесор"/><ComboBoxItem Content="Диск / I/O"/><ComboBoxItem Content="Пам’ять"/></ComboBox>
                            </Grid>
                            <Grid x:Name="ChartArea" Grid.Row="2" SizeChanged="ChartArea_SizeChanged">
                                <TextBlock x:Name="ChartEmptyText" Text="Програм не знайдено" Style="{StaticResource Label}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="ChartScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="ChartBars"><ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="0,0,8,16" ToolTip="{Binding Detail}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Rank}" Style="{StaticResource Label}" FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Medium" Margin="10,0,0,0"/>
                                            </Grid>
                                            <Border Height="8" Background="{DynamicResource TrackBrush}" CornerRadius="4"><Border Width="{Binding BarWidth}" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" CornerRadius="4"/></Border>
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="ProcessesPanel" Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Процеси" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ProcessCountText" Grid.Column="1" Text="Збираємо дані…" Style="{StaticResource Label}" VerticalAlignment="Center"/></Grid>
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource ControlBrush}" CornerRadius="19" Height="38" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="33"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Path Data="M 12 7 A 5 5 0 1 1 2 7 A 5 5 0 1 1 12 7 M 11 11 L 16 16" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource TextFont}" CaretBrush="{DynamicResource AccentBrush}" FontSize="12" Padding="2,0,10,0" VerticalContentAlignment="Center" SelectionBrush="{DynamicResource SelectionBrush}" AutomationProperties.Name="Знайти програму або службу" FocusVisualStyle="{StaticResource FocusRing}"/>
                                        <TextBlock Grid.Column="1" Text="Пошук програм і служб" Margin="2,0,10,0" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Label}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </Grid>
                                </Border>
                                <ComboBox x:Name="SortMetric" Grid.Column="2" SelectedIndex="0" SelectionChanged="SortMetric_SelectionChanged" AutomationProperties.Name="Сортувати процеси за"><ComboBoxItem Content="Процесор"/><ComboBoxItem Content="Диск / I/O"/><ComboBoxItem Content="Пам’ять"/></ComboBox>
                            </Grid>
                            <Grid Grid.Row="4" Margin="6,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="80"/><ColumnDefinition Width="89"/></Grid.ColumnDefinitions>
                                <TextBlock Text="ПРОГРАМА" Style="{StaticResource Label}" FontSize="9"/><TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource Label}" FontSize="9" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="ОЗП" Style="{StaticResource Label}" FontSize="9" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="I/O" Style="{StaticResource Label}" FontSize="9" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Grid.Row="5">
                                <TextBlock x:Name="ProcessEmptyText" Text="Спробуйте іншу назву" Style="{StaticResource Label}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                <ListBox x:Name="ProcessList" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource TextFont}" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="5,11" Margin="0,0,6,0" ToolTip="{Binding Detail}">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="80"/><ColumnDefinition Width="89"/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CountDetail}" Style="{StaticResource Label}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding CpuText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="{Binding MemoryText}" Foreground="{DynamicResource PurpleBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DiskText}" Foreground="{DynamicResource BlueBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Margin="3,13,3,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Однакові процеси об’єднано. I/O — читання й запис процесу; служби одного хоста мають спільні лічильники." Style="{StaticResource Label}" FontSize="10" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StatusText" Grid.Column="2" Text="Починаємо спостереження…" Style="{StaticResource Label}" FontSize="10"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
